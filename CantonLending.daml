          Some aggCid -> do
            _ <- exercise aggCid Aggregate_AddDeposit with
              amount = smusde.shares
              isNewPosition = isNewPos
            pure ()
          None -> do
            _ <- create LendingCollateralAggregate with
              operator
              collateralType = CTN_SMUSDE

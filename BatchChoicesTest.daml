-- ============================================================
-- 13. IDEMPOTENCY — Lending_BatchDepositSMUSD adds to existing escrow
-- ============================================================

-- | First deposit creates escrow, second deposit adds to same escrow via
-- existingEscrowCid. Verifies cumulative shares are tracked correctly.
test_Lending_BatchDepositSMUSD_Idempotency : Script ()
test_Lending_BatchDepositSMUSD_Idempotency = script do
  (operator, alice, _bob, regCid) <- setupParties
  stakeSvcCid <- createStakingService operator regCid
  lendSvcCid  <- createLendingService operator regCid

  -- First batch: 2 × 100
  m1 <- mintMusd operator alice 100.0
  m2 <- mintMusd operator alice 100.0
  (svc2, s1) <- submitMulti [alice] [operator] do
    exerciseCmd stakeSvcCid Stake with user = alice; musdCid = m1
  (svc3, s2) <- submitMulti [alice] [operator] do
    exerciseCmd svc2 Stake with user = alice; musdCid = m2

  (_lendSvcCid2, escrowCid1) <- submitMulti [alice] [operator] do
    exerciseCmd lendSvcCid Lending_BatchDepositSMUSD with
      user              = alice
      smusdCids         = [s1, s2]
      existingEscrowCid = None
      collateralAggCid  = None

  escrow1 <- queryContractId operator escrowCid1
  assertMsg "First batch: 200 shares" ((fromSome escrow1).amount == 200.0)

  -- Second batch: 1 × 100, adding to existing escrow
  m3 <- mintMusd operator alice 100.0
  (_svc4, s3) <- submitMulti [alice] [operator] do
    exerciseCmd svc3 Stake with user = alice; musdCid = m3

  -- Note: Lending_BatchDepositSMUSD is nonconsuming, so lendSvcCid is still valid
  (_lendSvcCid3, escrowCid2) <- submitMulti [alice] [operator] do
    exerciseCmd lendSvcCid Lending_BatchDepositSMUSD with
      user              = alice
      smusdCids         = [s3]
      existingEscrowCid = Some escrowCid1
      collateralAggCid  = None

  escrow2 <- queryContractId operator escrowCid2
  assertMsg "Second batch: 300 shares total" ((fromSome escrow2).amount == 300.0)

  debug "✅ 13. Lending_BatchDepositSMUSD — idempotency (cumulative deposits)"

-- ============================================================
-- 14. PARTIAL BATCH — ETHPool, requestedMusd < total value
-- ============================================================

-- | Provide 3 × 100 = 300 mUSD worth of tokens but only request 150.
-- Verify 150 mUSD is returned and all 3 tokens are archived.
test_ETHPool_BatchUnstake_PartialRequest : Script ()
test_ETHPool_BatchUnstake_PartialRequest = script do
  (operator, alice, _bob, regCid) <- setupParties
  poolSvcCid <- createPoolService operator regCid

  m1 <- mintMusd operator alice 100.0
  m2 <- mintMusd operator alice 100.0
  m3 <- mintMusd operator alice 100.0

  (poolSvcCid2, e1) <- submitMulti [alice] [operator] do
    exerciseCmd poolSvcCid ETHPool_Stake with
      user = alice; musdCid = m1; selectedTier = NoLock
  (poolSvcCid3, e2) <- submitMulti [alice] [operator] do
    exerciseCmd poolSvcCid2 ETHPool_Stake with
      user = alice; musdCid = m2; selectedTier = NoLock
  (poolSvcCid4, e3) <- submitMulti [alice] [operator] do
    exerciseCmd poolSvcCid3 ETHPool_Stake with
      user = alice; musdCid = m3; selectedTier = NoLock

  -- Request only 150 mUSD from 300 worth of tokens
  (poolSvcCid5, musdOut) <- submitMulti [alice] [operator] do
    exerciseCmd poolSvcCid4 ETHPool_BatchUnstake with
      user          = alice
      smusdeCids    = [e1, e2, e3]
      requestedMusd = 150.0

  mOut <- queryContractId alice musdOut
  assertMsg "Received exactly 150 mUSD" ((fromSome mOut).amount == 150.0)

  -- All 3 tokens archived — original CIDs should be gone
  check1 <- queryContractId alice e1
  check2 <- queryContractId alice e2
  check3 <- queryContractId alice e3
  assertMsg "e1 archived" (not (isSome check1))
  assertMsg "e2 archived" (not (isSome check2))
  assertMsg "e3 archived" (not (isSome check3))

  debug "✅ 14. ETHPool_BatchUnstake — partial request (150 of 300) accepted, all tokens archived"

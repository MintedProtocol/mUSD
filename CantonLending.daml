    -- | Deposit CantonSMUSD as collateral
    -- DAML-H-03: Nonconsuming — no service state changes on deposit
    nonconsuming choice Lending_DepositSMUSD : (ContractId CantonLendingService, ContractId EscrowedCollateral)
      with
        user     : Party

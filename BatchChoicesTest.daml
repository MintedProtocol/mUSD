-- 10. PAUSED SERVICE — Unstake_Batch
-- ============================================================

test_Staking_UnstakeBatch_Paused : Script ()
test_Staking_UnstakeBatch_Paused = script do
  (operator, alice, _bob, regCid) <- setupParties
  stakeSvcCid <- createStakingService operator regCid

  m1 <- mintMusd operator alice 100.0
  (svc2, s1) <- submitMulti [alice] [operator] do
    exerciseCmd stakeSvcCid Stake with user = alice; musdCid = m1

  svc3 <- submit operator do
    exerciseCmd svc2 Staking_SetPaused with newPaused = True

  submitMultiMustFail [alice] [operator] do
    exerciseCmd svc3 Unstake_Batch with
      user          = alice
      smusdCids     = [s1]
      requestedMusd = 100.0

  debug "✅ 10. Unstake_Batch — SERVICE_PAUSED enforced"

